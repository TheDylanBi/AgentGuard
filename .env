# ICB-Guard 配置文件示例
# 复制本文件为 .env，然后填入你的独立 LLM API key。
# 注意：这个 LLM 必须与执行任务的 agent LLM 是【不同的模型/端点】，
# 否则 agent 被注入攻击时，意图分析也会被污染。

# 独立意图/命令分析 LLM（必填，启用语义化）
ICB_INTENT_LLM_API_KEY=sk-97e3cc87c0c84b82b094df42416ac1e3
ICB_INTENT_LLM_BASE_URL=https://api.deepseek.com
ICB_INTENT_LLM_MODEL=deepseek-flash

# 可选：其他配置
# ICB_HOST=127.0.0.1
# ICB_PORT=8099
# ICB_REQUIRE_CAPABILITY=1
